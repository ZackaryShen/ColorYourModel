# 3D Model files (large binary files, use Git LFS or external storage)
*.stl
*.obj
*.3mf
*.ply
!examples/*.stl
!examples/*.3mf

# Distribution / packaging
*.tar.gz
*.zip
!releases/*.zip

# Local agent memory (project-specific, not for version control)
.workbuddy/

# Build backups created when bypassing the safe-delete shim (emptyOutDir:false)
dist_bak*/

# Ad-hoc cargo target dirs used when the main target dir lock is stuck (Windows orphan handles)
.cargo-target*/
.cargo-probe/

# isolated cargo target used for fast incremental checks
src-tauri/target_dev_rust/
